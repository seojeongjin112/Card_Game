  _useCardsHint: "\uC544\uB798 \uC561\uD2F0\uBE0C \uD6A8\uACFC \uCE74\uB4DC\uB97C
    \uB20C\uB7EC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  _flushHintFormat: "{0} \uBB38\uC591\uC774 4\uC7A5 \u2014 {0} 1\uC7A5\uB9CC \uB354
    \uC624\uBA74 <b>\uD50C\uB7EC\uC2DC({1}\uC810)</b>. \uB2E4\uB978 \uBB38\uC591
    \uCE74\uB4DC\uB97C \uB9AC\uB864\uD574 \uBCF4\uC138\uC694."
  _straightHintFormat: "\uC22B\uC790 {0} 1\uC7A5\uB9CC \uB354 \uC624\uBA74 <b>\uC2A4\uD2B8\uB808\uC774\uD2B8({1}\uC810)</b>.
    \uC5F0\uC18D\uC5D0 \uC548 \uC4F0\uC774\uB294 \uCE74\uB4DC\uB97C \uB9AC\uB864\uD574
    \uBCF4\uC138\uC694."
  _tripsHint: "\uD2B8\uB9AC\uD50C \uC644\uC131! \uAC19\uC740 \uC22B\uC790 1\uC7A5\uC774
