  _confirmHandLabel: "\uD328 \uD655\uC815 \u2192 03"
  _backLabel: "\u2190 \uD328 \uB2E4\uC2DC \uACE0\uB974\uAE30"
  _settleLabel: "\uC81C\uCD9C \uD655\uC815 \u2192 04"
