  _composePrompt: "\uACF5\uACA9\uD560 5\uC7A5\uC744 \uACE0\uB974\uC138\uC694"
  _draftHeading: "\uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0 \uB354\uD560 \uD6A8\uACFC
    \uCE74\uB4DC\uB97C \uACE0\uB974\uC138\uC694."
  _composeDescription: "\uD3EC\uCEE4 \uCE74\uB4DC 7\uC7A5 \uC911 5\uC7A5\uC744 \uACE8\uB77C
    \uC871\uBCF4\uB97C \uB9CC\uB4DC\uC138\uC694. \uC561\uD2F0\uBE0C \uD6A8\uACFC
    \uCE74\uB4DC\uB3C4 \uC9C0\uAE08 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  _rerollDescription: "\uB9AC\uB864 \uBAA8\uB4DC \xB7 \uBC14\uAFC0 \uCE74\uB4DC\uB97C
    \uB20C\uB7EC \uAD50\uCCB4\uD558\uC138\uC694"
  _draftDescription: "3\uC7A5 \uC911 1\uC7A5\uB9CC \uD68D\uB4DD\uD569\uB2C8\uB2E4.
    \uD6A8\uACFC \uCE74\uB4DC\uAC00 \uAC00\uB4DD \uCC28\uBA74 \uBC84\uB9B4 \uCE74\uB4DC\uB97C
    \uD568\uAED8 \uACE0\uB985\uB2C8\uB2E4."
