    \uB300\uAE30"
  _baseScoreFormat: "\uAE30\uBCF8 {0}\uC810"
  _rerollModeFormat: "\uB9AC\uB864 \uBAA8\uB4DC ({0})"
  _rerollCancelLabel: "\uCDE8\uC18C"
  _autoLabel: "\uCD5C\uC801 5\uC7A5 \uC790\uB3D9 \uC120\uD0DD"
