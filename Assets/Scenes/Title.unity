  _gameSceneName: Card
  _logoWord: RUNE DUEL
  _logoSub: "\uB8EC \uACB0\uD22C"
  _duelWord: DUEL
  _heroLabel: MY ACE
  _heroHeading: "\uC774\uBC88 \uD310\uC744 \uB05D\uB0B4\uB294 \uD55C \uC7A5"
  _heroDescription: "\uD3EC\uCEE4 \uC871\uBCF4\uC640 \uD6A8\uACFC \uCE74\uB4DC\uB85C
    \uC0C1\uB300\uC758 HP\uB97C \uBA3C\uC800 0\uC73C\uB85C \uB9CC\uB4DC\uC138\uC694."
  _deckFormat: "\uD6A8\uACFC \uB371 \xB7 \uC2A4\uD398\uC774\uB4DC \uC911\uC2EC \xB7
    {0}\uC7A5"
  _panelTitle: "1VS1 \uB4C0\uC5BC"
  _panelNote: "HP\uB97C \uBA3C\uC800 0\uC73C\uB85C"
  _startLabel: "\uAC8C\uC784 \uC2DC\uC791"
  _startSub: START
  _quitLabel: "\uC885\uB8CC"
  _quitSub: QUIT
  _soloSmall: "SOLO \xB7 VS AI"
  _soloTitle: "\uC5F0\uC2B5 \uB4C0\uC5BC"
  _howSmall: HOW TO PLAY
  _howTitle: "\uAC8C\uC784 \uBC29\uBC95"
  _howPill: "\uCC98\uC74C\uC774\uB77C\uBA74"
  _recordSmall: "\uCD5C\uADFC \uAE30\uB85D"
  _recordTitle: "\uAE30\uB85D \uC5C6\uC74C"
  _difficultyNames:
  - "\uC26C\uC6C0"
  - "\uBCF4\uD1B5"
  - "\uC5B4\uB824\uC6C0"
  _closeLabel: "\uB2EB\uAE30"
  _howToBody: "1. \uB77C\uC6B4\uB4DC\uB9C8\uB2E4 \uD6A8\uACFC \uCE74\uB4DC 3\uC7A5
    \uC911 1\uC7A5\uC744 \uACE8\uB77C \uC7A5\uCC29\uD569\uB2C8\uB2E4.\n2. \uD3EC\uCEE4
    \uCE74\uB4DC 7\uC7A5 \uC911 5\uC7A5\uC744 \uACE8\uB77C \uC871\uBCF4\uB97C \uB9CC\uB4E4\uACE0
    \uC81C\uCD9C\uD569\uB2C8\uB2E4.\n3. \uC561\uD2F0\uBE0C \uD6A8\uACFC \uCE74\uB4DC\uB97C
    \uC368\uC11C \uC810\uC218\uB97C \uC62C\uB9AC\uAC70\uB098 \uBC29\uC5B4\uB97C \uC900\uBE44\uD569\uB2C8\uB2E4.\n4.
    \uCD5C\uC885 \uC810\uC218 = (\uC871\uBCF4 \uC810\uC218 + \uBCF4\uB108\uC2A4)
    \xD7 \uBC30\uC728. \uC810\uC218\uAC00 \uB192\uC740 \uCABD\uC774 \uC774\uAE41\uB2C8\uB2E4.\n5.
    \uB450 \uC810\uC218\uC758 \uCC28\uC774\uB9CC\uD07C \uC9C4 \uCABD\uC758 HP\uAC00
    \uC904\uACE0, HP\uAC00 0\uC774 \uB418\uBA74 \uC804\uD22C\uAC00 \uB05D\uB0A9\uB2C8\uB2E4.\n6.
    \uB9AC\uB864\uC740 \uB77C\uC6B4\uB4DC\uB9C8\uB2E4 \uC815\uD574\uC9C4 \uD69F\uC218\uB9CC
    \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
